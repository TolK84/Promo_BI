		sourceColumn: Сумма

		annotation SummarizationSetBy = Automatic

	column 'Кол-во отгружено' = CALCULATE(SUM(fact_sales_line[Количество]), FILTER(ALL(fact_sales_line), fact_sales_line[ID строки заказа] = fact_order_line[ID строки заказа]))
		dataType: double
		formatString: #,0
		lineageTag: 29a9b96d-9cf8-5969-a455-586d70483419
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Кол-во к отгрузке' = [Количество] - [Кол-во отгружено]
		dataType: double
		formatString: #,0
		lineageTag: f8c0efaa-3d72-5fe0-ad27-f036fc0d0ba6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Статус отгрузки' = SWITCH(TRUE(), [Кол-во отгружено] = 0, "Не отгружен", [Кол-во отгружено] < [Количество], "Частично отгружен", "Отгружен")
		dataType: string
		lineageTag: 039598a3-04ab-51c1-a439-c9a34d00ddb9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_order_line = m
